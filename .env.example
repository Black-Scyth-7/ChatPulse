# ChatPulse site — environment variables
# Copy to `.env.local` for local dev, or set these in the Vercel project
# (Settings → Environment Variables, Production scope). None are required for the
# site to build; the waitlist works without them but see the note below.

# --- Site ---
# Canonical production origin, used for absolute URLs (sitemap, robots, OG tags).
# Set to the live domain once assigned. Falls back to the deployment URL if unset.
NEXT_PUBLIC_SITE_URL="https://chatpulse.app"

# --- Waitlist ---
# Where signups are persisted (append-only JSONL). Defaults to `.data/waitlist.jsonl`
# locally and `/tmp/waitlist.jsonl` on Vercel (the only writable path there).
# The /tmp file is EPHEMERAL per serverless instance — for durable capture set the
# webhook below. Point this at a managed store's path if you add one.
# WAITLIST_DATA_FILE="/tmp/waitlist.jsonl"

# Optional: forward each confirmed signup as JSON to this URL (Zapier/Make/ESP/CRM).
# Strongly recommended in production so signups survive cold starts.
# WAITLIST_WEBHOOK_URL="https://hooks.example.com/waitlist"
